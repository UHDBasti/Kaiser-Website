# ========================================
# KAISER-SERVICE WEBSITE - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# CRITICAL - REQUIRED FOR SECURITY
# ========================================

# Session Secret - MUST be unique and secure!
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-very-secure-random-secret-min-32-chars"

# Database Connection (PostgreSQL)
# Example for Neon: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for local: postgresql://postgres:password@localhost:5432/kaiser_db
DATABASE_URL="postgresql://user:password@host:5432/database"

# ========================================
# SITE CONFIGURATION
# ========================================

# Your site URL (used for email verification links, prevents Host Header Injection)
# Development: http://localhost:5000
# Production: https://your-domain.com
SITE_URL="http://localhost:5000"

# Node Environment (development | production)
NODE_ENV="development"

# Server Port (default: 5000)
PORT="5000"

# ========================================
# N8N WEBHOOK INTEGRATIONS (Optional)
# ========================================
# Leave empty if not using N8N automation

# AI Chatbot Webhook
N8N_CHAT_WEBHOOK_URL=""

# News Feed Webhook
N8N_NEWS_WEBHOOK_URL=""

# Email Verification Webhook
N8N_EMAIL_WEBHOOK_URL=""

# Contact Form Webhook
N8N_CONTACT_WEBHOOK_URL=""

# Voice Demo Booking Webhook
N8N_VOICE_WEBHOOK_URL=""

# ========================================
# ELEVENLABS VOICE AGENTS (Optional)
# ========================================
# Get your API key from: https://elevenlabs.io/app/settings/api-keys

ELEVENLABS_API_KEY=""

# ========================================
# ADMIN USER (Optional)
# ========================================
# Admin user will be created on first server start
# Password requirements: Min 8 chars, 1 uppercase, 1 lowercase, 1 digit

ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@kaiser-service.de"

# ========================================
# SECURITY NOTES
# ========================================
#
# 1. SESSION_SECRET must be changed from default!
#    - Generate a strong random secret
#    - Min 32 characters recommended
#    - Use: openssl rand -base64 32
#
# 2. DATABASE_URL should use SSL in production
#    - Add ?sslmode=require for PostgreSQL
#
# 3. SITE_URL must match your actual domain
#    - Prevents Host Header Injection attacks
#    - Used in email verification links
#
# 4. Admin password must be strong
#    - Min 8 characters
#    - Contains uppercase, lowercase, and digit
#
# 5. Never commit .env to Git
#    - Already in .gitignore
#    - Use .env.example for documentation
#
# ========================================
